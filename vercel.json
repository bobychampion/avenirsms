{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expire-demo",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-scheduled",
      "schedule": "0 * * * *"
    }
  ]
}
