{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "outDir": ".vercel/output/functions",
    "rootDir": "."
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "dist", "src", "functions"]
}
