# Production build-time config (Vite). These are PUBLIC OAuth parameters —
# the client ID and redirect URI are visible in the browser by design and are
# not secrets. Never put the Google client secret here; that stays server-side
# only in functions/.env (GOOGLE_CLIENT_SECRET).
#
# This file exists specifically to override .env.local's localhost redirect
# URI during `npm run build` (production mode) — without it, Vite's env
# precedence lets .env.local leak its dev-only values into production builds.
VITE_GOOGLE_CLIENT_ID=667778034571-40f781askp067fjumjkni9cbj16uvr3v.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://avenirsms.com.ng/auth/google/callback
# Must be the exact host that does NOT redirect — avenirsms.com.ng (no www) 308-redirects to
# www.avenirsms.com.ng, and browsers refuse to follow a redirect on a CORS preflight request, so
# every /api/* fetch() call fails with "Failed to fetch" no matter what CORS headers the API sends.
# (VITE_GOOGLE_REDIRECT_URI above is unaffected by this — that's a full-page OAuth navigation, not
# a fetch(), so browsers follow its redirect normally; leave it as registered in Google Cloud Console.)
VITE_API_BASE_URL=https://www.avenirsms.com.ng
